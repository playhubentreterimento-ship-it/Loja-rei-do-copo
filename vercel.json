{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/public/admin.html" },
    { "source": "/api/store", "destination": "/public/data/store.json" },
    { "source": "/((?!public/).*)", "destination": "/public/$1" }
  ],
  "headers": [
    {
      "source": "/public/frames/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/public/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
